# ==========================================
# Phoenix Environment Variables
# ==========================================

# Optional: GitHub Personal Access Token (increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# Required for AI signal analysis: Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq LLM Model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
